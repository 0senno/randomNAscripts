--------------------------------------------------------------------
-- Core Logic (blazing fast)
--------------------------------------------------------------------
local function CollectAllOrbs()
    if not RootPart or not Character or not Character.Parent then return 0 end
    
    local orbs = OrbCache[CurrentStage]
    if not orbs or #orbs == 0 then return 0 end
    
    -- Calculate bounding box center (touches all orbs)
    local minPos, maxPos = Vector3.one * math.huge, Vector3.one * -math.huge
    for _, orb in ipairs(orbs) do
        if orb and orb.Parent then
            local pos = orb.Position
            minPos = Vector3.new(math.min(minPos.X, pos.X), math.min(minPos.Y, pos.Y), math.min(minPos.Z, pos.Z))
            maxPos = Vector3.new(math.max(maxPos.X, pos.X), math.max(maxPos.Y, pos.Y), math.max(maxPos.Z, pos.Z))
        end
    end
    
    local center = (minPos + maxPos) / 2 + Vector3.new(0, 5, 0) -- 5 studs up
    RootPart.CFrame = CFrame.new(center)
    
    -- Single wait for .Touched events to fire
    task.wait(0.05)
    return #orbs
end

local function FarmLoop()
    while IsRunning do
        local collected = CollectAllOrbs()
        StatusLabel.Text = string.format("Stage %d | Collected: %d", CurrentStage, collected)
        
        -- Wait for respawn (adjust if needed)
        for i = 1, 7 do
            if not IsRunning then break end
            StatusLabel.Text = string.format("Respawn in %ds...", 7 - i)
            task.wait(1)
        end
    end
    StatusLabel.Text = "Ready | Orbs: 0"
end

-- Stage controls
StageBox.FocusLost:Connect(function()
    local num = tonumber(StageBox.Text)
    if num and num >= 1 and num <= MaxStage then
        CurrentStage = math.floor(num)
    end
    StageBox.Text = tostring(CurrentStage)
end)

LeftButton.MouseButton1Click:Connect(function()
    CurrentStage = math.max(1, CurrentStage - 1)
    StageBox.Text = tostring(CurrentStage)
end)

RightButton.MouseButton1Click:Connect(function()
    CurrentStage = math.min(MaxStage, CurrentStage + 1)
    StageBox.Text = tostring(CurrentStage)
end)

-- Toggle farming
ToggleButton.MouseButton1Click:Connect(function()
    IsRunning = not IsRunning
    if IsRunning then
        ToggleButton.Text = "STOP FARMING"
        ToggleButton.BackgroundColor3 = Color3.fromHex("#aa0000")
        FarmThread = task.spawn(FarmLoop)
    else
        ToggleButton.Text = "START FARMING"
        ToggleButton.BackgroundColor3 = Color3.fromHex("#00aa00")
        if FarmThread then task.cancel(FarmThread) end
    end
end)

