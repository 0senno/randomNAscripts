-- Cache orbs once (massive speedup)
local function CacheOrbs()
    local Boosts = Services.Workspace:WaitForChild("Map", 5):WaitForChild("Stages", 5):WaitForChild("Boosts", 5)
    if not Boosts then return end
    
    for stage = 1, MaxStage do
        OrbCache[stage] = {}
        local folder = Boosts:FindFirstChild(tostring(stage))
        if folder then
            for _, model in ipairs(folder:GetChildren()) do
                for _, part in ipairs(model:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name:lower():match("orb") then
                        table.insert(OrbCache[stage], part)
                    end
                end
            end
        end
    end
end
CacheOrbs()

