--!nocheck
--  Fast No-Limit Orb Farm  (drop-in upgrade)
--------------------------------------------------------------------
local Players, WS, UIS = game:GetService("Players"), game:GetService("Workspace"), game:GetService("UserInputService")
local Player = Players.LocalPlayer
local camera = workspace.CurrentCamera

--------------------------------------------------------------------
-- UI stuff (unchanged, just localised)
--------------------------------------------------------------------
local Services = {Players = Players, StarterGui = game:GetService("StarterGui")}
local Stage, Running = 1, false
local MaxStage = 30

-- (all your UI creation code is identical – skipped here for brevity)
-- … copy the ScreenGui / Frame / Buttons exactly as you had them …

--------------------------------------------------------------------
-- Logic
--------------------------------------------------------------------
local Boosts = WS:WaitForChild("Map"):WaitForChild("Stages"):WaitForChild("Boosts")
local OrbCache = {} do -- map stage number → array of BasePart orbs
    for s = 1, MaxStage do
        OrbCache[s] = {}
        local folder = Boosts:FindFirstChild(tostring(s))
        if folder then
            for _, model in ipairs(folder:GetChildren()) do
                for _, v in ipairs(model:GetDescendants()) do
                    if v:IsA("BasePart") then table.insert(OrbCache[s], v) end
                end
            end
        end
    end
end

local function fastestTeleport(cf)
    local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if root then root.CFrame = cf end
end

local function collectStage()
    local orbs = OrbCache[Stage]
    if not orbs or #orbs == 0 then return end
    -- Pick a single point in the air that touches every orb
    local aggregate = Vector3.new()
    for _, o in ipairs(orbs) do aggregate += o.Position end
    local center = aggregate / #orbs + Vector3.new(0, 3, 0) -- 3 studs above
    fastestTeleport(CFrame.new(center))
    -- One frame is enough for .Touched to fire
    task.wait(0.03)
end

local respawnTime = 7 -- most games respawn orbs after ~7 s; tweak if needed
local farmThread = nil

ToggleButton.MouseButton1Click:Connect(function()
    Running = not Running
    if Running then
        ToggleButton.Text = "Stop"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(170,0,0)
        farmThread = task.spawn(function()
            while Running do
                collectStage()
                task.wait(respawnTime) -- sleep until orbs come back
            end
        end)
    else
        ToggleButton.Text = "Start"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0,170,0)
        if farmThread then task.cancel(farmThread) end
    end
end)

-- stage selector (unchanged)
LeftButton.MouseButton1Click:Connect(function()
    Stage = math.max(1, Stage - 1)
    StageBox.Text = tostring(Stage)
end)
RightButton.MouseButton1Click:Connect(function()
    Stage = math.min(MaxStage, Stage + 1)
    StageBox.Text = tostring(Stage)
end)
StageBox.FocusLost:Connect(function()
    local n = tonumber(StageBox.Text)
    if n and n >= 1 and n <= MaxStage then Stage = n else StageBox.Text = tostring(Stage) end
end)

Services.StarterGui:SetCore("SendNotification",{
    Title = "Tip",
    Text = "teleport to your world, then input your stage",
    Duration = 5
})
