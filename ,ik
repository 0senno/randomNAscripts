local noclipConn = nil

local function refreshCharacter()
    character = player.Character or player.CharacterAdded:Wait()
    rootPart  = character:WaitForChild("HumanoidRootPart")
end

local function enableNoclip()
    if noclipConn then return end
    noclipConn = RunService.Stepped:Connect(function()
        if not character or not character.Parent then return end
        for _, p in ipairs(character:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.CanCollide = false end
        end
    end)
end

local function disableNoclip()
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
    if not character or not character.Parent then return end
    for _, p in ipairs(character:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.CanCollide = true end
    end
end

local function travelTo(targetCFrame)
    refreshCharacter()

    local targetPos = targetCFrame.Position
    local startPos  = rootPart.Position
    local dist      = (startPos - targetPos).Magnitude

    if dist < 0.5 then
        return function() end
    end

    enableNoclip()

    local bv = rootPart:FindFirstChild("FlightBV") or Instance.new("BodyVelocity")
    bv.Name = "FlightBV"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = rootPart

    local bg = rootPart:FindFirstChild("FlightBG") or Instance.new("BodyGyro")
    bg.Name = "FlightBG"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 500000
    bg.D = 500
    bg.CFrame = rootPart.CFrame
    bg.Parent = rootPart

    local cleaned = false
    local function cleanup()
        if cleaned then return end
        cleaned = true

        if bv and bv.Parent then bv:Destroy() end
        if bg and bg.Parent then bg:Destroy() end

        pcall(function()
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
        end)

        disableNoclip()
    end

    local function moveTo(destPos, lookAtPos, threshold)
        threshold = threshold or 2

        local startVec = rootPart.Position
        pcall(function()
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
        end)

        local legDist = (startVec - destPos).Magnitude
        if legDist < 0.1 then return end

        if legDist > 600 then
            local segments = math.ceil(legDist / 600)
            local stepVec = (destPos - startVec) / segments
            for i = 1, segments do
                local nodePos = startVec + (stepVec * i)
                moveTo(nodePos, lookAtPos, threshold)
            end
            return
        end

        local dir = (lookAtPos - startVec)
        local flatDir = Vector3.new(dir.X, 0, dir.Z)
        if flatDir.Magnitude < 0.01 then
            flatDir = rootPart.CFrame.LookVector
        end

        local goalRot = CFrame.lookAt(Vector3.zero, flatDir)
        local startCFrame = CFrame.new(startVec) * goalRot
        local endCFrame   = CFrame.new(destPos) * goalRot

        bg.CFrame = endCFrame

        local duration = legDist / math.max(FLIGHT_SPEED, 1)
        local t0 = tick()

        while tick() - t0 < duration do
            if not rootPart or not rootPart.Parent then break end
            local alpha = (tick() - t0) / duration
            rootPart.CFrame = startCFrame:Lerp(endCFrame, alpha)

            if (rootPart.Position - destPos).Magnitude <= threshold then
                break
            end

            RunService.Heartbeat:Wait()
        end

        rootPart.CFrame = endCFrame

        if legDist > 300 then
            task.wait(0.2)
        end
    end

    local startVec = rootPart.Position
    if dist < 25 then
        moveTo(targetPos, targetPos)
    else
        local safeY = math.max(startVec.Y, targetPos.Y) + 40
        local p1 = Vector3.new(startVec.X, safeY, startVec.Z)
        local p2 = Vector3.new(targetPos.X, safeY, targetPos.Z)
        moveTo(p1, p2)
        moveTo(p2, p2)
        moveTo(targetPos, targetPos)
    end

    return cleanup
end

local function getDangerLevel(enemyModel)
    local myState = character and character:FindFirstChild("State")
    local myRankVal = myState and myState:FindFirstChild("QiRank")
    local myRank = myRankVal and myRankVal.Value
    
    local eState = enemyModel:FindFirstChild("State")
    local eRankVal = eState and eState:FindFirstChild("QiRank")
    local eRank = eRankVal and eRankVal.Value
    
    if myRank and eRank then
        return eRank - myRank
    end
    
    local myH = character and character:FindFirstChildOfClass("Humanoid")
    local eH = enemyModel:FindFirstChildOfClass("Humanoid")
    local mh = myH and myH.MaxHealth or 100
    local eh = eH and eH.MaxHealth or 100
    
    if mh > 0 then
        return (eh - mh) / mh
    end
    
    return 0
end

local function isTargetOneShot(enemyModel)
    local danger = getDangerLevel(enemyModel)
    local myH = character and character:FindFirstChildOfClass("Humanoid")
    local eH = enemyModel:FindFirstChildOfClass("Humanoid")
    local mh = myH and myH.MaxHealth or 100
    local eh = eH and eH.MaxHealth or 100
    
    return danger < 0 and eh <= (mh * 0.5)
end

local function getAliveEnemies()
    local list = {}
    for _, obj in ipairs(enemiesFolder:GetDescendants()) do
        if obj:IsA("Model") then
            local danger = getDangerLevel(obj)
            if useFilter and danger >= 1.5 then continue end
            if useEasyOnly and danger >= 0.0 then continue end
            if useOneShot and not isTargetOneShot(obj) then continue end
            
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            local ePart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
            if humanoid and humanoid.Health > 0 and ePart then
                table.insert(list, {model = obj, part = ePart})
            end
        end
    end
    return list
end

print("Starting Flight-based Auto-QiRelease Farm...")

local function startFarm()
    task.spawn(function()
        while autoFarming do
            refreshCharacter()

            local targets = getAliveEnemies()
            if #targets == 0 then
                task.wait(1)
                continue
            end

            -- Priority 1: Check for alive Bosses if toggle is ON
            local bossTargets = {}
            if useBossFarm then
                for _, info in ipairs(targets) do
                    if CollectionService:HasTag(info.model, "Boss") then
                        table.insert(bossTargets, info)
                    end
                end
            end

            -- Choose the array of targets to focus on
            local activeTargets = (#bossTargets > 0) and bossTargets or targets

            table.sort(activeTargets, function(a, b)
                return (a.part.Position - rootPart.Position).Magnitude < (b.part.Position - rootPart.Position).Magnitude
            end)

            for _, eInfo in ipairs(activeTargets) do
                if not autoFarming then break end
                
                local ePart = eInfo.part
                if not ePart or not ePart.Parent then continue end
                local eHum = ePart.Parent:FindFirstChildOfClass("Humanoid")
                if eHum and eHum.Health <= 0 then continue end
                
                local isLocalBoss = CollectionService:HasTag(eInfo.model, "Boss")
                
                -- Teleport/Fly directly behind the enemy (4 studs behind their back)
                local backCFrame = ePart.CFrame * CFrame.new(0, 0, 4)
                
                -- We want the player to face the enemy when we arrive
                local finishFlight = travelTo(CFrame.lookAt(backCFrame.Position, ePart.Position))

                if not ePart.Parent or (eHum and eHum.Health <= 0) then 
                    if finishFlight then finishFlight() end
                    continue 
                end

                if isLocalBoss and useBossFarm then
                    -- Boss attack logic (Light melee spam)
                    local args = {
                        "Light",
                        {
                            RootPart = rootPart
                        }
                    }
                    
                    -- Stay locked onto this boss until it dies
                    while autoFarming and ePart.Parent and eHum and eHum.Health > 0 do
                        -- Keep glued to the boss's back even if it moves
                        local dynamicBackCFrame = ePart.CFrame * CFrame.new(0, 0, 4)
                        rootPart.CFrame = CFrame.lookAt(dynamicBackCFrame.Position, ePart.Position)
                        rootPart.AssemblyLinearVelocity = Vector3.zero
                        rootPart.AssemblyAngularVelocity = Vector3.zero
                        
                        pcall(function() attackEvent:FireServer(unpack(args)) end)
                        task.wait(0.15)
                    end
                    
                    if finishFlight then
                        finishFlight()
                    end
                    -- Break out to force a rescan, guaranteeing we finish bosses one at a time
                    break
                else
                    -- Standard QiRelease logic + 3-hit combo
                    pcall(function() qiReleaseEvent:FireServer() end)
                    pcall(function() qiReleaseEvent:FireServer(ePart.Position) end)
                    
                    local args = {
                        "Light",
                        {
                            RootPart = rootPart
                        }
                    }
                    for i = 1, 3 do
                        pcall(function() attackEvent:FireServer(unpack(args)) end)
                        task.wait(0.05)
                    end
                end
                
                if finishFlight then
                    finishFlight()
                end
            end
            task.wait(0.2)
        end
    end)
end

